<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/live_video"
        android:scaleType="fitCenter" />

    <!-- Not part of the zoomed picture: always visible, so it proves the stream is alive. -->
    <TextView
        android:id="@+id/liveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/live_badge_bg"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:typeface="monospace"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="#99000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <Button
        android:id="@+id/exitFullscreenButton"
        style="@style/ControlButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/exit_fullscreen"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scanButton"
                style="@style/ControlButton"
                android:text="@string/scan_qr" />

            <Button
                android:id="@+id/addressButton"
                style="@style/ControlButton"
                android:text="@string/address" />

            <Button
                android:id="@+id/cameraButton"
                style="@style/ControlButton"
                android:text="@string/camera_button" />

            <Button
                android:id="@+id/disconnectButton"
                style="@style/ControlButton"
                android:text="@string/forget" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/torchButton"
                style="@style/ControlButton"
                android:text="@string/torch_on" />

            <Button
                android:id="@+id/brightButton"
                style="@style/ControlButton"
                android:text="@string/bright" />

            <Button
                android:id="@+id/fullscreenButton"
                style="@style/ControlButton"
                android:text="@string/fullscreen" />

            <Button
                android:id="@+id/exitButton"
                style="@style/ControlButton"
                android:text="@string/exit" />
        </LinearLayout>

        <Button
            android:id="@+id/tailscaleButton"
            style="@style/ControlButton.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/get_tailscale" />
    </LinearLayout>
</FrameLayout>
